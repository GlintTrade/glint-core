# Glint REST API base URL (the hosted URL is listed at https://tradeglint.xyz/docs)
GLINT_API_URL=http://localhost:8787
# API key from the account page on https://tradeglint.xyz (starts with ek_)
GLINT_API_KEY=
# Website where the user signs with their own wallet
GLINT_WEB_URL=https://tradeglint.xyz
# Optional: API request timeout, ms
GLINT_TIMEOUT_MS=60000
